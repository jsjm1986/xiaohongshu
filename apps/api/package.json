{
  "name": "@content-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch --watch-path=src --watch-path=../../packages/agent-core/dist src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@content-agent/agent-core": "0.1.0",
    "@content-agent/agent-harness-core": "0.1.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.5.1",
    "express": "5.2.1",
    "ipaddr.js": "2.4.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.3",
    "fast-check": "3.23.2",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
