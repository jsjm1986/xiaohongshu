PORT=8780
HOST=127.0.0.1
CONTENT_AGENT_DATA_DIR=./data
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Production defaults to Secure cookies. Only disable this for trusted local HTTP.
# CONTENT_AGENT_SECURE_COOKIES=false
# Optional platform provider. Workspaces can also configure encrypted BYOK in the UI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSPORT=responses
# Staged generation defaults: bounded waits, six total attempts with exponential backoff,
# and two parallel model calls. Retry attempts and concurrency must be between 1 and 8.
CONTENT_AGENT_MODEL_TIMEOUT_MS=90000
CONTENT_AGENT_MODEL_RETRY_ATTEMPTS=6
CONTENT_AGENT_MODEL_RETRY_BASE_DELAY_MS=4000
CONTENT_AGENT_MODEL_MAX_CONCURRENT=2
# A running job heartbeats every 15 seconds and is reclaimable after 90 seconds.
# The claim timeout must be strictly greater than the heartbeat interval.
CONTENT_AGENT_JOB_HEARTBEAT_MS=15000
CONTENT_AGENT_JOB_CLAIM_TIMEOUT_MS=90000
# BYOK endpoints default to public HTTPS only. These exceptions weaken SSRF protection;
# enable them only for a trusted, isolated gateway you administer.
# CONTENT_AGENT_BYOK_ALLOW_HTTP=false
# CONTENT_AGENT_BYOK_ALLOW_PRIVATE_NETWORK=false
# OpenAI-compatible Claude gateways may use these aliases instead:
# ANTHROPIC_BASE_URL=https://gateway.example/v1
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_OPUS_MODEL=provider/claude-model
MASTER_ENCRYPTION_KEY=
KNOWLEDGE_CONTEXT_TOKENS=180000
CONTENT_AGENT_CJK_FONT_PATH=
